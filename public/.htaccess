<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,NE,R=301]

    # Allow favicons, brand icons, and webmanifest to be served directly on any host (including www) without 301 redirect
    # This ensures Google-Favicon crawler receives a direct 200 OK whether crawling www or apex domain
    RewriteCond %{REQUEST_URI} ^/(favicon.*|apple-touch-icon.*|android-chrome.*|site\.webmanifest|logo.*) [NC]
    RewriteRule ^ - [L]

    # Force Non-WWW Canonical Domain for all other pages
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,NE,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Direct /blog requests to medialibrary/blog directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^blog/(.*)$ medialibrary/blog/$1 [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^(favicon.*|apple-touch-icon.*|android-chrome.*|logo.*)\.(ico|png)$">
    <IfModule mod_headers.c>
        Header always set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
        Header always unset Pragma
        Header always unset Expires
        Header always set Access-Control-Allow-Origin "*"
    </IfModule>
    <IfModule mod_expires.c>
        ExpiresActive On
        ExpiresDefault "access plus 30 days"
    </IfModule>
</FilesMatch>

<Files "service-worker.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Service-Worker-Allowed "/"
    </IfModule>
</Files>

<IfModule mod_headers.c>
    # Ensure Vary header always includes X-Inertia and Accept
    Header append Vary "X-Inertia, Accept"

    # Prevent browsers and proxies from caching Inertia JSON responses
    SetEnvIfNoCase X-Inertia "^true$" IS_INERTIA
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=IS_INERTIA
    Header set Pragma "no-cache" env=IS_INERTIA
    Header set X-LiteSpeed-Cache-Control "no-cache" env=IS_INERTIA
</IfModule>

# Disable ModSecurity false positives on rich text CMS article posts
<IfModule mod_security.c>
    SecRuleEngine Off
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>
<IfModule mod_security2.c>
    SecRuleEngine Off
</IfModule>


